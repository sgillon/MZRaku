<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless runner (v1.4 decision D10): runs an EmulatorSession
       unpaced, with no window or sound device, and writes the same
       dump files as the app. Built on MZRaku.Core alone, so it also
       proves the core needs no Windows Forms. The regression suite
       runs it through regress.py's headless option. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MZRakuHeadless</RootNamespace>
    <AssemblyName>MZRakuHeadless</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\MZRaku.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="MZRaku.Core" />
  </ItemGroup>

</Project>
