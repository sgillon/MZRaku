<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>MZRaku.ico</ApplicationIcon>
    <AssemblyName>MZRaku</AssemblyName>
    <RootNamespace>MZRaku</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Feature version. Semver, bumped on release. Use the in-progress
         value (the one the next git tag will carry). Surfaced in the
         About dialog and read from AssemblyInformationalVersion at
         runtime — see StampInformationalVersion below for how the full
         string is composed. -->
    <Version>1.2.0</Version>
    <!-- Build number. Manually bumped before each publish; format
         YYYYMMDD-NNN where NNN is a per-day counter (001, 002, …).
         Composed with the git short-SHA into InformationalVersion by
         the StampInformationalVersion target below, so a single About
         dialog line reads e.g. "Build 20260822-001 (g106280e)". Serves
         as the tiebreaker when two builds carry the same <Version> —
         a "which exe am I looking at" indicator distinct from the
         feature version. -->
    <BuildNumber>20260825-001</BuildNumber>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Release publish settings: bundle everything into a single .exe.
       PDBs are embedded (no separate .pdb file) so stack traces still
       carry line numbers if something crashes. Only Release publishes
       are affected — Debug build and dotnet run are unchanged.
       EnableCompressionInSingleFile is not used here: it's only valid
       for self-contained bundles, and we ship framework-dependent
       (assumes the .NET 8 Desktop Runtime is installed). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="Z80Core\Z80Core.csproj" />
  </ItemGroup>

  <!-- Sibling sub-projects build separately; exclude their sources from
       this project to avoid double-compile errors. -->
  <ItemGroup>
    <Compile Remove="tools/**/*.cs" />
    <None Remove="tools/**/*" />
    <Compile Remove="Z80Core/**/*.cs" />
    <None Remove="Z80Core/**/*" />
  </ItemGroup>

  <!-- Embedded resources for the single-file publish: the app icon
       loaded at runtime by Form.Icon. Listed explicitly to avoid
       inadvertently pulling in local working files (e.g. icon source
       PNGs in _hardwareimages/). -->
  <ItemGroup>
    <!-- MZRaku.ico is also embedded as the Win32 resource via
         <ApplicationIcon> above (used by Explorer, taskbar, alt-tab);
         the EmbeddedResource entry lets MainForm load it at runtime
         for the window title-bar icon. Source PNG + regen script
         live in assets/. -->
    <EmbeddedResource Include="MZRaku.ico" />
    <!-- Brand logo shown in the Help → About dialog (Phase 7). Same
         image as the README header; embedded so the single-file
         publish stays self-contained. AboutForm loads via
         GetManifestResourceStream. -->
    <EmbeddedResource Include="docs\mzraku_logo.png" />
  </ItemGroup>

  <!-- Compose the final InformationalVersion at build time from three
       inputs: <Version> (feature semver), <BuildNumber> (manual per-
       publish tag), and the current git short-SHA (auto). Result looks
       like "1.1.0+20260822-001.g106280e" — a valid SemVer 2.0 string
       (build metadata after the '+') that the About dialog parses back
       into two display lines. Runs BeforeTargets="GetAssemblyAttributes"
       so the emitted AssemblyInformationalVersionAttribute picks up
       the composed value.

       Failure modes handled: if git isn't available or the tree isn't
       a repo (downloaded zip, etc.) the Exec fails silently
       (IgnoreExitCode) and the SHA suffix is omitted — string still
       parses cleanly as "1.1.0+20260822-001". -->
  <Target Name="StampInformationalVersion" BeforeTargets="GetAssemblyAttributes">
    <Exec Command="git rev-parse --short=7 HEAD"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitShaShort" />
    </Exec>
    <PropertyGroup>
      <InformationalVersion Condition="'$(GitShaShort)' != ''">$(Version)+$(BuildNumber).g$(GitShaShort)</InformationalVersion>
      <InformationalVersion Condition="'$(GitShaShort)' == ''">$(Version)+$(BuildNumber)</InformationalVersion>
    </PropertyGroup>
  </Target>

  <!-- Copyrighted ROM / BASIC images are NOT shipped with this project.
       Users must supply their own copies under roms\ and basic\ next to
       the source tree (or next to the published executable); Settings.cs
       walks up from the run directory to find them, and settings.ini
       records the resolved paths. See the Quickstart in README.md.
       CopyToPublishDirectory=Never prevents 'dotnet publish' picking
       up the developer's local copies — they go into the build output
       (bin/) so 'dotnet run' works, but never into a release bundle. -->
  <ItemGroup>
    <None Include="roms\*.rom;roms\*.int;roms\*.txt;basic\*.mzf"
          Condition="Exists('roms') or Exists('basic')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
